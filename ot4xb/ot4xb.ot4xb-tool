{
	"versioninfo": "./source/ot4xb.VersionInfo",
	"pre.release": {
		"folders": {
			"src": "./source",
			"out": "<src>"
		},
		"steps": [
			"vbuild",
			"codegen"
		],
		"vbuild": {
			"flags": ""
		},
		"codegen": {
			"cleanup.before": {
				"files": [
					"<src>/Release/ot4xb.obj",
					"<src>/Debug/ot4xb.obj",
					"<src>/ot4xb.def",
					"<src>/ot4xbCpp.def",
					"<src>/ot4xb_xbexports.hpp",
					"<src>/ot4xb_xbfunclist.hpp"
				]
			},
			"xbmac2h": {
				"src": "<src>/ot4xb.xbmac"
			}
		}
	},
	"pre.debug": {
		"template": "pre.release"
	},
	"post.debug": {
		"folders": {
			"src": "./source",
			"dst": "./Debug"
		},
		"steps": [
			"def2lib20"
		],
		"def2lib20": {
			"in": "<src>/ot4xb.def",
			"out": "<dst>/ot4xb.lib",
			"monkey": true
		}
	},
	"docs": {
		"folders": {
			"src": "./source",
			"out": "./out"
		},
		"steps": [
			"docs"
		],
		"docs": {
			"doc_tool": "./ot4xb.doc-tool",
			"out": "<out>/md",
			"clean": true
		}
	},
	"post.release": {
		"vars": {
			"bo": "ot4xb_<v.maj:03>_<v.min:03>_<v.hbuild:03>_<v.lbuild:03>"
		},
		"folders": {
			"src": "./source",
			"tmp": "<src>/Release",
			"dst": "./Release",
			"deploy": "<dst>/builds/_<bo>",
			"out": "./out"
		},
		"steps": [
			"def2lib20",
			"docs",
			"artefacts"
		],
		"docs": {
			"doc_tool": "./ot4xb.doc-tool",
			"out": "<out>/md",
			"clean": true
		},
		"def2lib20": {
			"in": "<src>/ot4xb.def",
			"out": "<dst>/ot4xb.lib",
			"monkey": true
		},
		"artefacts": [
			{
				"type": "zip",
				"zip_filename": "<deploy>/_<bo>.zip",
				"content": [
					{
						"in": [
							"<dst>/*.lib",
							"<dst>/ot4xb.dll",
							"<src>/*.txt"
						],
						"out": "/"
					},
					{
						"in": [
							"<src>/ch/*.ch",
							"<src>/ch/*.txt"
						],
						"out": "/include",
						"clean_doc_comments": true
					}
				]
			},
			{
				"type": "zip",
				"zip_filename": "<deploy>/_<bo>_source.zip",
				"content": [
					{
						"in": [
							"./ot4xb.sln",
							"./ot4xb.ot4xb-tool"
						],
						"out": "/"
					},
					{
						"in": [
							"<src>/*.c",
							"<src>/*.cpp",
							"<src>/*.h",
							"<src>/*.hpp",
							"<src>/*.def",
							"<src>/*.rc",
							"<src>/*.txt",
							"<src>/*.xbmac",
							"<src>/*.VersionInfo",
							"<src>/*.vcxproj",
							"<src>/*.filters"
						],
						"out": "/source",
						"clean_doc_comments": true
					},
					{
						"in": [
							"<src>/ch/*.ch"
						],
						"out": "/source/ch",
						"clean_doc_comments": true
					}
				]
			},
			{
				"type": "zip",
				"zip_filename": "<deploy>/<bo>_doc.zip",
				"content": [
					{
						"in": [
							"<out>/md/*.md"
						],
						"out": "/"
					}
				]
			}
		]
	}
}
